{
  "name": "mac-code",
  "version": "0.31.0",
  "description": "Modern PowerShell wrapper for Windows built on Electron + xterm.js + node-pty",
  "main": "main.js",
  "author": "Marcus",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/cascadia-code": "^5.1.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-serialize": "^0.11.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.marcus.mac-code",
    "productName": "Mac Code",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "renderer.js",
      "chatView.js",
      "flowState.js",
      "autoMode.js",
      "claudeSessions.js",
      "githubView.js",
      "github.js",
      "ghArgs.js",
      "ghTimeline.js",
      "notesView.js",
      "noteImages.js",
      "settings.js",
      "appThemes.js",
      "changelog.js",
      "claudeConfig.js",
      "flowCompile.js",
      "flowStore.js",
      "flowEditor.js",
      "settingsView.js",
      "repoUsage.js",
      "tabGroups.js",
      "deployStatus.js",
      "errorNotes.js",
      "errorHook.js",
      "folderUri.js",
      "pasteText.js",
      "hooks/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
